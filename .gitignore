build
build-fw
build-local
build-test

# The RP2350 datasheet is ~8MB and CC BY-ND licensed; keeping it out of git
# history avoids permanent repo bloat. Download it into docs/ from
# https://datasheets.raspberrypi.com/rp2350/rp2350-datasheet.pdf
# docs/rp2350-datasheet-index.md is committed and records the revision it was
# generated from; regenerate with scripts/gen-datasheet-index.py.
docs/*.pdf

# pymavlink generator venv (see generate-mavlink.sh)
.venv/

# Bench run logs and captured data (see scripts/bench/README.md for why these
# are generated output, gitignored like build/, rather than committed -- and
# how to override that for one run worth keeping).
bench-logs/*
!bench-logs/.gitkeep
bench-data/*
!bench-data/.gitkeep
