{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": ["docker *"],
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "raspberrypi.com",
        "*.raspberrypi.com"
      ],
      "strictAllowlist": true
    }
  },
  "permissions": {
    "allow": [
      "Bash(find *)",
      "Bash(cmake -S test -B build-test*)",
      "Bash(cmake --build build-test*)",
      "Bash(ctest --test-dir build-test*)",
      "Bash(./scripts/test.sh*)",
      "Bash(./build-test/lln_tests*)",
      "Bash(clang-format --version)",
      "Bash(clang-format -style=file*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch --list*)",
      "Bash(git remote -v)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue create*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue close*)",
      "Bash(gh issue reopen*)",
      "Bash(gh issue edit*)"
    ],
    "ask": [
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(scp*)",
      "Bash(rsync*)",
      "Bash(ssh*)",
      "Bash(nc*)",
      "Bash(git push*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git remote add*)",
      "Bash(git remote set-url*)",
      "Bash(gh api*)",
      "Bash(gh repo*)",
      "Bash(gh pr*)",
      "Bash(gh release*)",
      "Bash(gh gist*)",
      "Bash(gh auth*)",
      "Bash(docker*)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(npm install*)",
      "Bash(sudo*)",
      "Bash(chmod*)",
      "Bash(chown*)",
      "Bash(mv*)",
      "Bash(cp*)",
      "Bash(dd*)",
      "Bash(tee*)",
      "Bash(find * -exec*)",
      "Bash(find * -delete*)",
      "Bash(find * -execdir*)",
      "Bash(find * -ok*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(//etc/shadow)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.netrc)",
      "Edit(~/.bashrc)",
      "Edit(~/.profile)",
      "Edit(~/.bash_profile)",
      "Edit(~/.claude/settings.json)",
      "Edit(//etc/**)",
      "Edit(//usr/**)",
      "Edit(//bin/**)",
      "Edit(//boot/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git filter-branch*)",
      "Bash(gh repo delete*)",
      "Bash(gh issue delete*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(:(){*)"
    ]
  }
}
